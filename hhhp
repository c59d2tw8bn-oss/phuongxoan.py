def _read_int(prompt, default=None, minimum=1):
    raw = input(prompt).strip()
    if not raw and default is not None:
        return default
    val = int(raw)
    if val < minimum:
        raise ValueError(f"Value must be >= {minimum}")
    return val

def main_menu():
    global stop_event, total_scanned, found_accounts, rate_limited, request_count

    series_map = {
        '1': '2009-2010', '2': '2011-2012',
        '3': '2013-2014', '4': '2015',
        '5': 'old',       '6': 'all',
    }

    while True:
        banner()
        print(f"""
{YELLOW}[1]{RESET} Scan 2009-2010
{YELLOW}[2]{RESET} Scan 2011-2012
{YELLOW}[3]{RESET} Scan 2013-2014
{YELLOW}[4]{RESET} Scan 2015
{YELLOW}[5]{RESET} Scan ID Sieu Co (2004-2009)
{YELLOW}[6]{RESET} Scan Random All
{BLUE}[7]{RESET} Scan tu file UID (uid.txt)
{YELLOW}[0]{RESET} Thoat
""")
        choice = input(f"{WHITE}[?] Chon chuc nang: {RESET}").strip()

        if choice == '0':
            print(f"{GREEN}[+] Ket qua luu tai {OUTPUT_HIT}{RESET}")
            sys.exit(0)

        uid_list = []
        if choice == '7':
            if not os.path.exists(UID_FILE):
                print(f"{RED}[!] Khong tim thay uid.txt{RESET}")
                time.sleep(1.5)
                continue
            with open(UID_FILE, 'r', encoding='utf-8') as f:
                uid_list = [line.strip() for line in f if line.strip()]
            print(f"{GREEN}[+] Loaded {len(uid_list)} UIDs tu file{RESET}")
        elif choice in series_map:
            try:
                total = _read_int(f"{YELLOW}[?] So luong ID muon scan: {RESET}", minimum=1)
            except ValueError:
                print(f"{RED}[!] So luong ID khong hop le{RESET}")
                time.sleep(1.2)
                continue
            uid_list = list({generate_uid(series_map[choice]) for _ in range(total)})
        else:
            print(f"{RED}[!] Lua chon khong hop le{RESET}")
            time.sleep(1)
            continue

        try:
            threads_n = _read_int(f"{YELLOW}[?] So thread (khuyen 20-50): {RESET}", default=30, minimum=1)
        except ValueError:
            print(f"{RED}[!] So thread khong hop le{RESET}")
            time.sleep(1.2)
            continue

        method_idx = {'v1': 0, 'v2': 1, 'v3': 2}.get(
            input(f"{YELLOW}[?] Method (v1/v2/v3, mac dinh v1): {RESET}").strip().lower(), 0
        )

        with scan_lock:
            total_scanned = 0
            found_accounts = 0
            rate_limited = 0
        with req_lock:
            request_count = 0

        stop_event = threading.Event()
        print(f"\n{GREEN}[+] Bat dau scan {len(uid_list)} UIDs voi {threads_n} thread...{RESET}\n")
        print(f"{YELLOW}[!] Nhan Ctrl+C de dung{RESET}\n")

        start = datetime.now()
        try:
            with ThreadPoolExecutor(max_workers=threads_n) as ex:
                futures = {ex.submit(worker, uid, method_idx): uid for uid in uid_list}
                for fut in as_completed(futures):
                    if stop_event.is_set():
                        break
                    fut.result()
        except KeyboardInterrupt:
            stop_event.set()
            print(f"\n{RED}[!] Dung boi nguoi dung{RESET}")

        elapsed = int((datetime.now() - start).total_seconds())
        with scan_lock:
            final_hits = found_accounts
            final_scanned = total_scanned
        print(f"\n\n{MAGENTA}[✓] Hoan thanh trong {elapsed}s | "
              f"Hit: {final_hits} | Scan: {final_scanned}{RESET}")
        input(f"{WHITE}[Enter] de tiep tuc...{RESET}")

